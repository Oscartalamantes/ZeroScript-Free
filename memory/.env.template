# OscarMCP persistent-memory stack - environment template.
# Copy to .env beside memory_stack.py on the laptop and adjust.
# No secrets: every endpoint is local Ollama (keyless).

# On-disk store (Chroma + Kuzu). Default: C:\Users\Etern\juno\memory
JUNO_MEMORY_DIR=

# Local Ollama (OpenAI-compatible endpoint)
JUNO_OLLAMA_URL=http://127.0.0.1:11434/v1

# Memory WRITER model. Today: a model already on the OMEN.
# After `ollama pull hf.co/rapatsky/Hy-Memory-30B-A3B-GGUF:Q4_K_M`
# completes, set this to that tag - the dedicated Hy-Memory writer -
# and restart the bridge. Nothing else changes.
JUNO_MEMORY_WRITER=llama3.1:8b

# Embedder (already pulled on the OMEN)
JUNO_MEMORY_EMBEDDER=nomic-embed-text

# MUST match the embedder's vector size (nomic-embed-text = 768).
# The SDK default is 1536 and will reject the vectors if this is wrong.
JUNO_MEMORY_EMBEDDING_DIMS=768

# SDK mode: pro = LLM extraction + reconcile (graph optional).
JUNO_MEMORY_MODE=pro
JUNO_MEMORY_USER=oscar
